name: "Test OIDC Connection"

on:
  push:
    branches:
      - main
  workflow_dispatch:

# Esto fuerza a GitHub a usar Node.js 24 y hace desaparecer el Warning
env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"

permissions:
  id-token: write
  contents: read

jobs:
  test-aws-connection:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Configurar credenciales de AWS (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: us-east-1 # Tu región de AWS

      - name: Probar conexión con AWS CLI
        run: |
          aws sts get-caller-identity
